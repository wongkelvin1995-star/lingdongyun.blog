---
import type { Plan } from '../data/plans';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
---

<div
  class={`relative flex flex-col justify-between rounded-2xl p-6 sm:p-7 transition-all duration-300 ${
    plan.isPopular
      ? 'bg-[#161c30] border-2 border-purple-500/60 shadow-xl shadow-purple-950/40 lg:-translate-y-2'
      : 'bg-[#141827] border border-purple-900/30 hover:border-purple-500/40 hover:shadow-lg hover:shadow-purple-950/20'
  }`}
>
  {plan.isPopular && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-md shadow-purple-900/60 border border-purple-400/40">
        <svg class="w-3.5 h-3.5 text-amber-300" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {plan.tag || '推荐方案'}
      </span>
    </div>
  )}

  <div>
    <!-- Header info -->
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="text-xl font-bold text-white tracking-tight">
          {plan.name}
        </h3>
        <p class="mt-1 text-xs text-purple-300/80 font-mono">
          {plan.cycleName}
        </p>
      </div>
      {!plan.isPopular && plan.tag && (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium text-slate-300 bg-slate-800/80 border border-slate-700/60">
          {plan.tag}
        </span>
      )}
    </div>

    <!-- Price Section -->
    <div class="mt-5 pb-5 border-b border-slate-800/80">
      <div class="flex items-baseline gap-1.5">
        <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-mono">
          ¥{plan.price}
        </span>
        <span class="text-xs text-slate-400 font-medium">
          {plan.periodLabel}
        </span>
      </div>

      <!-- Traffic Highlight -->
      <div class="mt-3 flex items-center gap-2">
        <div class="flex items-center justify-center w-5 h-5 rounded bg-sky-950 text-sky-400 border border-sky-500/30">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="text-sm font-semibold text-sky-300 font-mono">
          {plan.trafficDisplay}
        </span>
      </div>
      <p class="mt-1 text-xs text-slate-400 leading-normal">
        {plan.trafficRule}
      </p>
    </div>

    <!-- Audience description -->
    <div class="mt-4 p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 text-xs text-slate-300 leading-relaxed">
      <span class="text-purple-400 font-medium">适合人群：</span> {plan.audience}
    </div>

    <!-- Features -->
    <div class="mt-5">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
        包含服务权益
      </div>
      <ul class="space-y-2.5 text-xs text-slate-300">
        {plan.features.map((feature) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-purple-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="leading-normal">{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- CTA Button & notes -->
  <div class="mt-7 pt-4">
    <a
      href={plan.ctaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-full py-3 px-4 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 transition-all duration-200 ${
        plan.isPopular
          ? 'bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-lg shadow-purple-950/60 border border-purple-400/30'
          : 'bg-slate-800/90 hover:bg-purple-900/40 text-white border border-purple-900/30 hover:border-purple-500/40'
      }`}
    >
      <span>{plan.ctaText}</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    {plan.notes && (
      <p class="mt-2 text-[11px] text-slate-400 text-center leading-normal">
        {plan.notes}
      </p>
    )}
  </div>
</div>
