---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanCard from '../../components/PlanCard.astro';
import { SITE } from '../../data/site';
import { PLANS, PLAN_FILTERS, PLAN_DISCLAIMERS } from '../../data/plans';
---

<Layout
  title="套餐价格与方案对比"
  description="灵动云官方套餐价格表与选购指引。提供灵动·拂风（20元/月）、灵动·驭浪（50元/月）、灵动·穿云（99元/年）、灵动·闲云（199元一次性）等 9 档参考方案，支持按月重置与一次性流量包按需选购。"
>
  <div class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: '套餐价格' }]} />

      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mt-6">
        <span class="linear-badge">PLANS & PRICING</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          灵活清晰的方案与计费体系
        </h1>
        <p class="mt-4 text-base text-slate-300 leading-relaxed">
          灵动云秉持公开透明原则，所有计费周期、流量到期规则与适用设备均明确展示。支持根据您的日常网络使用频次自主选择。
        </p>
      </div>

      <!-- Plan Filter Buttons (Interactive via Client-side JS) -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2" id="plan-filter-tabs">
        {PLAN_FILTERS.map((filter, index) => (
          <button
            type="button"
            data-filter={filter.id}
            class={`plan-tab-btn px-4 py-2 text-xs sm:text-sm font-semibold rounded-lg transition-all ${
              index === 0
                ? 'bg-purple-600 text-white shadow-md shadow-purple-900/40 border border-purple-400/30'
                : 'bg-slate-900/80 text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-800'
            }`}
          >
            {filter.label}
          </button>
        ))}
      </div>

      <!-- Plan Cards Grid -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="plans-container">
        {PLANS.map((plan) => (
          <div class="plan-card-item" data-cycle={plan.cycle}>
            <PlanCard plan={plan} />
          </div>
        ))}
      </div>

      <!-- Comprehensive Plan Comparison Table -->
      <div class="mt-20 pt-16 border-t border-purple-900/20">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="linear-badge">SIDE BY SIDE</span>
          <h2 class="mt-3 text-2xl sm:text-3xl font-bold text-white">
            全系列套餐横向参数对照表
          </h2>
          <p class="mt-2 text-xs text-slate-400">
            横向对比流量重置周期、适合人群与核心使用建议。
          </p>
        </div>

        <div class="linear-card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="bg-purple-950/40 border-b border-slate-800 text-slate-300">
                <tr>
                  <th class="p-4 font-semibold">套餐名称</th>
                  <th class="p-4 font-semibold">参考价格</th>
                  <th class="p-4 font-semibold">流量额度</th>
                  <th class="p-4 font-semibold">流量结算规则</th>
                  <th class="p-4 font-semibold">适合人群画像</th>
                  <th class="p-4 font-semibold text-center">操作</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/60 text-slate-300">
                {PLANS.map((plan) => (
                  <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="p-4 font-bold text-white whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <span>{plan.name}</span>
                        {plan.isPopular && (
                          <span class="px-1.5 py-0.5 rounded text-[10px] bg-purple-600 text-white font-mono">
                            HOT
                          </span>
                        )}
                      </div>
                    </td>
                    <td class="p-4 font-mono text-purple-300 font-bold whitespace-nowrap">
                      ¥{plan.price} <span class="text-xs text-slate-400 font-normal">{plan.periodLabel}</span>
                    </td>
                    <td class="p-4 font-mono font-medium text-sky-300 whitespace-nowrap">
                      {plan.trafficDisplay}
                    </td>
                    <td class="p-4 text-xs text-slate-300 max-w-xs">
                      {plan.trafficRule}
                    </td>
                    <td class="p-4 text-xs text-slate-400 max-w-xs">
                      {plan.audience}
                    </td>
                    <td class="p-4 text-center whitespace-nowrap">
                      <a
                        href={plan.ctaUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md bg-purple-600/80 hover:bg-purple-500 text-white border border-purple-400/30 transition-all"
                      >
                        <span>选购</span>
                        <svg class="ml-1 w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Billing Disclaimers & Notes -->
      <div class="mt-14 rounded-2xl bg-purple-950/20 border border-purple-900/30 p-6 sm:p-8">
        <h3 class="text-sm font-bold text-white flex items-center gap-2">
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>服务说明与合规准则</span>
        </h3>
        <ul class="mt-4 space-y-2 text-xs text-slate-400 leading-relaxed list-disc list-inside">
          {PLAN_DISCLAIMERS.map((rule) => (
            <li>{rule}</li>
          ))}
        </ul>
      </div>

      <!-- Bottom Conversion -->
      <div class="mt-16 text-center">
        <p class="text-sm text-slate-300">
          如需了解如何选购最经济的方案，推荐阅读我们的专题分析文章：
        </p>
        <div class="mt-3">
          <a href="/blog/plan-selection-guide/" class="text-sm font-semibold text-purple-400 hover:text-purple-300 inline-flex items-center gap-1">
            <span>《灵动云套餐选择完全指南：月付、年付与不限时流量包深度对比》</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Tab filtering logic
  const tabButtons = document.querySelectorAll('.plan-tab-btn');
  const planItems = document.querySelectorAll('.plan-card-item');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styles
      tabButtons.forEach((b) => {
        b.classList.remove('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-900/40', 'border-purple-400/30');
        b.classList.add('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
      });
      btn.classList.add('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-900/40', 'border-purple-400/30');
      btn.classList.remove('bg-slate-900/80', 'text-slate-300', 'border-slate-800');

      // Filter cards
      planItems.forEach((card) => {
        const cycle = card.getAttribute('data-cycle');
        if (filter === 'all' || cycle === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
