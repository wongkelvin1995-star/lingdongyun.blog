---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort(
    (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );

  return sorted.map((post, index) => {
    const prevPost = index < sorted.length - 1 ? sorted[index + 1] : null;
    const nextPost = index > 0 ? sorted[index - 1] : null;
    const relatedPosts = sorted
      .filter((p) => p.id !== post.id && (p.data.category === post.data.category || p.data.featured))
      .slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost, relatedPosts },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await render(post);

// Article structured schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate || post.data.pubDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: 'https://lingdongyun.blog/',
  },
  publisher: {
    '@type': 'Organization',
    name: '灵动云',
    logo: {
      '@type': 'ImageObject',
      url: 'https://lingdongyun.blog/logo-512.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://lingdongyun.blog/blog/${post.id}/`,
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <article class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        crumbs={[
          { label: '技术博客', href: '/blog/' },
          { label: post.data.title },
        ]}
      />

      <!-- Article Header -->
      <header class="mt-8 pb-8 border-b border-purple-900/30">
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-400 mb-4">
          <span class="px-2.5 py-0.5 rounded-full bg-purple-950 text-purple-300 border border-purple-500/30 font-medium">
            {post.data.category}
          </span>
          <span class="text-slate-600">·</span>
          <span>发布日期: <time datetime={post.data.pubDate} class="font-mono text-slate-300">{post.data.pubDate}</time></span>
          {post.data.updatedDate && (
            <>
              <span class="text-slate-600">·</span>
              <span>更新时间: <time datetime={post.data.updatedDate} class="font-mono text-purple-300">{post.data.updatedDate}</time></span>
            </>
          )}
          <span class="text-slate-600">·</span>
          <span>作者: <span class="text-slate-300">{post.data.author}</span></span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          {post.data.title}
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed font-sans">
          {post.data.description}
        </p>

        <!-- Tags -->
        {post.data.tags && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <span class="text-xs text-slate-400 bg-slate-900/80 px-2.5 py-1 rounded-md border border-slate-800">
                #{t}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Article Prose Content -->
      <div class="mt-10 prose prose-invert max-w-none prose-headings:text-white prose-headings:font-bold prose-h1:text-3xl prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-purple-900/30 prose-h3:text-xl prose-h3:mt-6 prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-purple-400 hover:prose-a:text-purple-300 prose-strong:text-white prose-code:text-purple-300 prose-code:bg-purple-950/40 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-pre:bg-[#0c101d] prose-pre:border prose-pre:border-purple-900/30 prose-table:border-collapse prose-th:border-b prose-th:border-slate-700 prose-th:p-3 prose-th:text-white prose-td:border-b prose-td:border-slate-800 prose-td:p-3 prose-td:text-slate-300 prose-blockquote:border-l-4 prose-blockquote:border-purple-500 prose-blockquote:bg-purple-950/20 prose-blockquote:p-4 prose-blockquote:rounded-r-lg prose-li:text-slate-300">
        <Content />
      </div>

      <!-- Article Footer Conversion CTA -->
      <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-purple-950/40 to-slate-900/80 border border-purple-500/30 text-center">
        <h3 class="text-lg sm:text-xl font-bold text-white">
          即刻开启灵动云 · 畅享高速稳定的全球网络
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-slate-300 max-w-lg mx-auto">
          香港、台湾、日本、新加坡及美国优质专线节点，全平台一键导入，开启流畅数字新体验。
        </p>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={SITE.registerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-sm py-2.5 px-6 w-full sm:w-auto"
          >
            <span>立即注册并选择套餐</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/pricing/"
            class="btn-secondary text-sm py-2.5 px-5 w-full sm:w-auto"
          >
            <span>查看完整价格</span>
          </a>
        </div>
      </div>

      <!-- Prev / Next Post Navigation -->
      <div class="mt-12 pt-8 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}/`}
            class="linear-card p-4 flex flex-col justify-between group"
          >
            <span class="text-xs text-purple-400 font-mono flex items-center gap-1 mb-1">
              <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              上一篇文章
            </span>
            <span class="text-sm font-semibold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.id}/`}
            class="linear-card p-4 flex flex-col justify-between text-right group"
          >
            <span class="text-xs text-purple-400 font-mono flex items-center justify-end gap-1 mb-1">
              下一篇文章
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
            <span class="text-sm font-semibold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
              {nextPost.data.title}
            </span>
          </a>
        ) : <div />}
      </div>

      <!-- Related Posts Recommendations -->
      {relatedPosts.length > 0 && (
        <div class="mt-16 pt-12 border-t border-slate-800">
          <h2 class="text-xl font-bold text-white mb-6">相关推荐文章</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedPosts.map((r) => (
              <a href={`/blog/${r.id}/`} class="linear-card p-4 group flex flex-col justify-between">
                <div>
                  <span class="text-[10px] text-purple-300 font-mono">{r.data.category}</span>
                  <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-purple-300 transition-colors mt-1 line-clamp-2">
                    {r.data.title}
                  </h3>
                </div>
                <div class="mt-3 text-[11px] text-slate-400 font-mono">
                  {r.data.pubDate}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
