---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import PlanCard from '../components/PlanCard.astro';
import { SITE } from '../data/site';
import { PLANS } from '../data/plans';
import { NODE_REGIONS, NETWORK_TECH_SPECS } from '../data/nodes';
import { CLIENT_APPS, PLATFORMS } from '../data/clients';
import { FAQS } from '../data/faqs';
import { getCollection } from 'astro:content';

// Fetch recent blog posts
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

// Top featured plans for homepage
const featuredPlans = PLANS.filter((p) => ['fufeng', 'yulang', 'chuanyun', 'xianyun'].includes(p.id));
---

<Layout
  title="灵动云 LingDongYun｜全球网络加速服务品牌"
  description="灵动云（LingDongYun）专注于为用户提供便捷、高效且具有性价比的全球网络加速服务。采用 IEPL/IPLC 优化线路方案，提供香港、日本、新加坡、台湾、美国等热门地区节点，满足 AI 工具访问、海外流媒体、在线学习、国际网站浏览及跨境办公需求。"
>
  <!-- ============================================== -->
  <!-- 01 & 02: MAX 品牌首屏 (Hero Section)           -->
  <!-- ============================================== -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-12 pb-20">
    <HeroArt />

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- 英文眉题 (Eyebrow) -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-purple-950/70 border border-purple-500/30 text-purple-300 text-xs sm:text-sm font-mono tracking-widest uppercase mb-8 shadow-inner shadow-purple-900/30">
        <span class="w-2 h-2 rounded-full bg-sky-400 animate-ping"></span>
        <span>LINGDONG CLOUD · FUTURE NETWORK</span>
      </div>

      <!-- 主标题 (H1) -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.25]">
        <span>灵动云 LingDongYun</span><span class="hidden sm:inline text-purple-400/70 font-light mx-2">｜</span><span class="block sm:inline text-gradient-purple-blue mt-1.5 sm:mt-0">全球网络加速服务品牌</span>
      </h1>

      <!-- 副标题 / 品牌介绍 (Subtitle) -->
      <div class="mt-8 mx-auto max-w-3xl text-sm sm:text-base lg:text-lg text-[#A0A7BB] leading-relaxed space-y-4 text-center">
        <p>
          灵动云（LingDongYun）专注于为用户提供便捷、高效且具有性价比的全球网络加速服务，以专业线路优化、简洁易用的产品体验和灵活多样的套餐选择为核心发展方向。
        </p>
        <p class="text-slate-300/90 text-xs sm:text-sm lg:text-[15px]">
          灵动云采用 IEPL/IPLC 优化线路方案，提供香港、日本、新加坡、台湾、美国等热门地区的网络节点选择，满足 AI 工具访问、海外流媒体、在线学习、国际网站浏览及跨境办公等多种网络使用需求。
        </p>
      </div>

      <!-- 主要行动按钮 (CTA Buttons) -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={SITE.registerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full sm:w-auto text-base"
        >
          <span>立即开启连接</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <a
          href="/pricing/"
          class="btn-secondary w-full sm:w-auto text-base"
        >
          <span>探索套餐价格</span>
          <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- 首屏品牌特性快照 -->
      <div class="mt-14 pt-10 border-t border-purple-900/20 grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-900/30">
          <div class="text-xs text-purple-300 font-mono">CORE INFRA</div>
          <div class="text-sm font-semibold text-white mt-1">多线 BGP / IEPL 专线</div>
        </div>
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-900/30">
          <div class="text-xs text-sky-300 font-mono">GLOBAL NODES</div>
          <div class="text-sm font-semibold text-white mt-1">港 / 台 / 日 / 新 / 美</div>
        </div>
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-900/30">
          <div class="text-xs text-indigo-300 font-mono">PLATFORMS</div>
          <div class="text-sm font-semibold text-white mt-1">全平台客户端适配</div>
        </div>
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-900/30">
          <div class="text-xs text-emerald-300 font-mono">PRIVACY FIRST</div>
          <div class="text-sm font-semibold text-white mt-1">零日志 / 强加密传输</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- 03: 灵动云核心优势 (Core Features)            -->
  <!-- ============================================== -->
  <section class="py-20 border-t border-purple-900/20 bg-[#0a0d17]/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <span class="linear-badge">
          <span>AETHER MAX ARCHITECTURE</span>
        </span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          精密而克制的网络加速架构
        </h2>
        <p class="mt-3 text-base text-slate-400">
          灵动云拒绝未经核验的虚假夸大，以稳固的基础设施设计为基石，为您的跨境连接注入持续动力。
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-purple-900/40 border border-purple-500/30 flex items-center justify-center text-purple-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">低抖动专线冗余</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            核心传输节点部署 IEPL / IPLC 专线冗余通道，二层专网传输不走公网骨干海缆，有效抑制晚高峰网络拥堵与丢包波动。
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-sky-900/40 border border-sky-500/30 flex items-center justify-center text-sky-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">智能规则与无感分流</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            全系节点配置现代化 GEOIP 与精准域名分流规则，国内服务完全直连不耗流量，海外特定域名智能匹配最佳出口线路。
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-indigo-900/40 border border-indigo-500/30 flex items-center justify-center text-indigo-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">跨端全生态兼容</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            全面适配 Windows、macOS、Android、iOS 及 Linux，提供一键导入和通用订阅格式，让多端协同体验无缝顺畅。
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-emerald-900/40 border border-emerald-500/30 flex items-center justify-center text-emerald-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">隐私优先与零日志</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            恪守无日志隐私准则，节点中转不记录用户访问的目标 URL、浏览数据或会话内容，保障您的数字资产与个人隐私安全。
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-amber-900/40 border border-amber-500/30 flex items-center justify-center text-amber-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">全天候健康监控热备</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            自动化运维监控引擎秒级探测节点状态，遭遇偶发公网链路断纤或运营商故障时，多套备用通道可实现快速旁路容灾。
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="linear-card p-7">
          <div class="w-11 h-11 rounded-xl bg-rose-900/40 border border-rose-500/30 flex items-center justify-center text-rose-300 mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white">官方工单与技术支持</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">
            告别无人回应的松散社群，官方用户中心提供严谨的技术工单系统，资深网络工程师为您解答客户端配置与排查疑难。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- 04: 全球节点与地区展示 (Global Nodes)          -->
  <!-- ============================================== -->
  <section class="py-20 border-t border-purple-900/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="linear-badge">VERIFIED REGIONS</span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            全球公开核心节点网络
          </h2>
          <p class="mt-2 text-sm text-slate-400 max-w-2xl">
            基于香港、台湾、日本、新加坡、美国等已公开规划地区。清晰定位每处节点的网络拓扑与业务专长。
          </p>
        </div>
        <div>
          <a href="/network/" class="text-sm font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1.5">
            <span>查看完整节点与线路架构</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {NODE_REGIONS.map((region) => (
          <div class="linear-card p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl">{region.flag}</span>
                  <div>
                    <h3 class="text-lg font-bold text-white">{region.name}</h3>
                    <span class="text-xs text-slate-400 font-mono">{region.enName} ({region.code})</span>
                  </div>
                </div>
                <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-purple-950/80 text-purple-300 border border-purple-500/30">
                  {region.tag}
                </span>
              </div>

              <div class="mt-4 p-2.5 rounded bg-slate-900/60 border border-slate-800 text-xs text-slate-300 font-mono">
                {region.architecture}
              </div>

              <p class="mt-3.5 text-xs text-slate-400 leading-relaxed">
                {region.description}
              </p>

              <div class="mt-4 space-y-1.5">
                <div class="text-[11px] font-semibold text-slate-300">核心优势：</div>
                {region.highlights.slice(0, 2).map((item) => (
                  <div class="flex items-center gap-1.5 text-xs text-slate-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-400">推荐场景：</span>
              <span class="text-purple-300 font-medium">{region.bestFor[0]}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- 05: 网络线路与技术说明 (Network Specs)         -->
  <!-- ============================================== -->
  <section class="py-20 border-t border-purple-900/20 bg-[#070913]/90">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="linear-badge">TECHNICAL SPECIFICATIONS</span>
          <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            透明公开的工程技术准则
          </h2>
          <p class="mt-3 text-sm text-slate-400 leading-relaxed">
            灵动云拒绝使用华而不实的营销黑话。我们从底层的接入网关、传输专线到应用分流规则，为每一位用户提供扎实可靠的技术保障。
          </p>

          <div class="mt-8 space-y-5">
            {NETWORK_TECH_SPECS.map((spec, i) => (
              <div class="flex items-start gap-3.5">
                <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-purple-950 text-purple-300 border border-purple-500/30 text-xs font-mono font-bold shrink-0">
                  0{i + 1}
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">{spec.title}</h3>
                  <p class="mt-1 text-xs text-slate-400 leading-relaxed">{spec.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8">
            <a href="/features/" class="btn-secondary text-sm">
              <span>探索全部核心技术架构</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Terminal / Technical Diagram Panel -->
        <div class="rounded-2xl border border-purple-900/30 bg-[#0d1222] p-6 shadow-2xl shadow-purple-950/20 font-mono text-xs">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-slate-400 text-[11px]">lingdong-aether-mesh.diag</span>
          </div>
          <div class="pt-4 space-y-2.5 text-slate-300 leading-relaxed overflow-x-auto">
            <p class="text-purple-400">$ aether-ctl route --status</p>
            <p class="text-slate-400">> Initiating AETHER MAX BGP Transit check...</p>
            <p><span class="text-emerald-400">✓ HK-01 (Hong Kong)</span>: BGP Dedicated Direct | Loss: 0.0% | Status: HEALTHY</p>
            <p><span class="text-emerald-400">✓ TW-01 (Taiwan)</span>: Asia Backbone Transit | Loss: 0.0% | Status: HEALTHY</p>
            <p><span class="text-emerald-400">✓ JP-01 (Tokyo)</span>: Premium Datacenter Loop | Loss: 0.0% | Status: HEALTHY</p>
            <p><span class="text-emerald-400">✓ SG-01 (Singapore)</span>: Submarine Cable Hub | Loss: 0.0% | Status: HEALTHY</p>
            <p><span class="text-emerald-400">✓ US-01 (Silicon Valley)</span>: AI Cluster Transit | Loss: 0.0% | Status: HEALTHY</p>
            <p class="text-sky-400 mt-3">> Split Routing Rule: GEOIP CN -> DIRECT | FOREIGN -> PROXY</p>
            <p class="text-purple-300">> Protocol Suite: Modern Shadowsocks / Trojan / Vless</p>
            <p class="text-slate-400 mt-2">All routes redundant and verified. Zero synthetic ping spoofing enabled.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- 06: 使用场景 (AI, 影音, 办公, 学术)           -->
  <!-- ============================================== -->
  <section class="py-20 border-t border-purple-900/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <span class="linear-badge">VERSATILE USE CASES</span>
        <h2 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          赋能多元数字生活场景
        </h2>
        <p class="mt-3 text-base text-slate-400">
          无论您是探索前沿大模型的开发者、追求原画质体验的影音爱好者，还是跨国协同团队，灵动云都能提供针对性的网络加速支持。
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Scenario 1 -->
        <div class="linear-card p-6">
          <div class="w-10 h-10 rounded-lg bg-sky-950 text-sky-400 border border-sky-500/30 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-white">前沿 AI 模型交互</h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            支持 ChatGPT、Claude、Midjourney 与 GitHub Copilot。提供纯净美国与日本原生出口，规避地理封控与频繁踢出会话。
          </p>
        </div>

        <!-- Scenario 2 -->
        <div class="linear-card p-6">
          <div class="w-10 h-10 rounded-lg bg-purple-950 text-purple-400 border border-purple-500/30 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
