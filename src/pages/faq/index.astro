---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { FAQS } from '../../data/faqs';
import { SITE } from '../../data/site';

const categories = Array.from(new Set(FAQS.map((f) => f.category)));
---

<Layout
  title="常见问题与官方解答 FAQ"
  description="灵动云常见问题解答中心。汇集官网真伪辨别、月付与一次性套餐区别、Clash/小火箭客户端导入、节点稳定性评估与订阅安全防泄露全套官方解答。"
>
  <div class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: '常见问题' }]} />

      <div class="mt-6 text-center max-w-2xl mx-auto">
        <span class="linear-badge">KNOWLEDGE & ANSWERS</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          常见问题与官方解答
        </h1>
        <p class="mt-4 text-base text-slate-300 leading-relaxed">
          关于灵动云服务、套餐计费、客户端导入及订阅安全的真实透明解答。
        </p>
      </div>

      <!-- Category Filter Buttons -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          data-cat="all"
          class="faq-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-purple-600 text-white shadow-md shadow-purple-900/40 border border-purple-400/30 transition-all"
        >
          全部分类
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-cat={cat}
            class="faq-filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-900/80 text-slate-300 hover:text-white border border-slate-800 transition-all"
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- FAQ Accordion List -->
      <div class="mt-12 space-y-4" id="faq-list">
        {FAQS.map((faq) => (
          <details
            class="faq-item linear-card group p-5 open:border-purple-500/50 transition-all cursor-pointer"
            data-category={faq.category}
          >
            <summary class="flex items-center justify-between text-base font-bold text-white list-none select-none">
              <span class="flex items-center gap-3">
                <span class="text-xs px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-500/20 font-mono">
                  {faq.category}
                </span>
                <span>{faq.question}</span>
              </span>
              <span class="ml-4 w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center text-purple-400 group-open:rotate-180 transition-transform shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-3 border-t border-slate-800/80 text-sm text-slate-300 leading-relaxed whitespace-pre-line">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Need more help CTA -->
      <div class="mt-16 p-6 rounded-2xl bg-[#0e1322] border border-purple-900/30 text-center">
        <h3 class="text-base font-bold text-white">
          没有找到您需要的答案？
        </h3>
        <p class="mt-2 text-xs text-slate-400">
          如遇复杂的网络环境报错或需要专属支持，请直接登录官方后台提交技术工单。
        </p>
        <div class="mt-4">
          <a
            href={SITE.registerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs py-2.5 px-5"
          >
            <span>登录并提交技术工单</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.faq-filter-btn');
  const faqItems = document.querySelectorAll('.faq-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');

      filterBtns.forEach((b) => {
        b.classList.remove('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-900/40', 'border-purple-400/30');
        b.classList.add('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
      });
      btn.classList.add('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-900/40', 'border-purple-400/30');
      btn.classList.remove('bg-slate-900/80', 'text-slate-300', 'border-slate-800');

      faqItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
