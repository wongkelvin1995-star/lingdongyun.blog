---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../data/site';
import { CLIENT_APPS, PLATFORMS } from '../../data/clients';
---

<Layout
  title="客户端下载中心 · 全平台适配"
  description="灵动云官方客户端下载中心。全面适配 Windows 10/11、macOS (Apple Silicon & Intel)、Android 手机/平板、iOS (iPhone/iPad) 及 Linux，提供最新开源客户端与订阅配置指引。"
>
  <div class="py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: '客户端下载' }]} />

      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mt-6">
        <span class="linear-badge">OFFICIAL CLIENT CENTER</span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          多设备全生态客户端下载
        </h1>
        <p class="mt-4 text-base text-slate-300 leading-relaxed">
          全面拥抱现代化 Mihomo / Clash Meta 开源生态。选择适配您设备的操作系统，一键获取安全客户端并同步灵动云订阅。
        </p>
      </div>

      <!-- Quick Platform Jump Anchor Pills -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        {PLATFORMS.map((platform) => (
          <a
            href={`#${platform.id}`}
            class="px-4 py-2 rounded-lg bg-slate-900/80 hover:bg-purple-900/30 text-xs sm:text-sm font-medium text-slate-300 hover:text-white border border-slate-800 hover:border-purple-500/40 transition-all flex items-center gap-2"
          >
            <span>{platform.name}</span>
          </a>
        ))}
      </div>

      <!-- Platforms Sections -->
      <div class="mt-16 space-y-16">
        {PLATFORMS.map((platform) => {
          const apps = CLIENT_APPS.filter((a) => a.platform === platform.id);
          return (
            <div id={platform.id} class="pt-6 scroll-mt-24">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-purple-900/30 mb-8">
                <div>
                  <h2 class="text-2xl font-bold text-white flex items-center gap-3">
                    <span>{platform.name} 平台推荐客户端</span>
                  </h2>
                  <p class="mt-1 text-xs text-slate-400">{platform.desc}</p>
                </div>
                {platform.path !== '/download/' && (
                  <a
                    href={platform.path}
                    class="text-xs font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 shrink-0"
                  >
                    <span>查看 {platform.name} 完整图文教程</span>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                )}
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {apps.map((app) => (
                  <div class="linear-card p-6 flex flex-col justify-between">
                    <div>
                      <div class="flex items-start justify-between gap-2">
                        <div>
                          <h3 class="text-lg font-bold text-white">{app.name}</h3>
                          <span class="text-xs text-purple-300 font-mono">{app.kernel}</span>
                        </div>
                        {app.badge && (
                          <span class={`px-2 py-0.5 rounded text-[11px] font-semibold ${
                            app.isRecommended 
                              ? 'bg-purple-600 text-white' 
                              : 'bg-slate-800 text-slate-300'
                          }`}>
                            {app.badge}
                          </span>
                        )}
                      </div>

                      <p class="mt-3 text-xs text-slate-400 leading-relaxed">
                        {app.desc}
                      </p>

                      <div class="mt-4 space-y-1.5">
                        <div class="text-[11px] font-semibold text-slate-300">功能亮点：</div>
                        {app.features.map((f) => (
                          <div class="flex items-start gap-1.5 text-xs text-slate-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shrink-0 mt-1.5"></span>
                            <span>{f}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                      <a
                        href={app.docUrl}
                        class="text-xs font-medium text-slate-300 hover:text-purple-300 transition-colors"
                      >
                        配置教程 →
                      </a>

                      <a
                        href={SITE.registerUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-primary text-xs py-2 px-3.5"
                      >
                        <span>获取订阅并连接</span>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Linux & Advanced Setup Note -->
      <div class="mt-16 rounded-2xl bg-slate-900/60 border border-slate-800 p-6 sm:p-8">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Linux 服务器与路由器部署支持</span>
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-slate-400 leading-relaxed">
          灵动云订阅格式为标准通用 YAML / Base64 / Mihomo 配置文件。在 Ubuntu、Debian 或 OpenWrt 等软路由系统中，您可以直接将订阅 URL 填入 Mihomo 核心守护进程或 ShellCrash 中，实现局域网级别的透明网关加速。
        </p>
      </div>
    </div>
  </div>
</Layout>
